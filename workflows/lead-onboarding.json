    {
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Validate & Normalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Accepts JSON or form-encoded bodies and produces one clean lead record.\nconst raw = $json.body ?? $json;\nconst cfg = $json.cfg ?? {};\n\nconst str = (v) => (v === undefined || v === null ? '' : String(v)).trim();\nconst titleCase = (s) => s.toLowerCase().replace(/(^|[\\s'-])\\S/g, (m) => m.toUpperCase());\n\nconst name = titleCase(str(raw.name || raw.full_name || raw.fullName));\nconst email = str(raw.email).toLowerCase();\nconst company = str(raw.company || raw.organisation || raw.organization);\nconst message = str(raw.message || raw.comments).slice(0, 2000);\nconst source = str(raw.source || raw.utm_source || 'website');\n\nconst errors = [];\nif (name.length < 2) errors.push('name is required');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) errors.push('email is invalid');\n\nconst freeMailDomains = ['gmail.com', 'yahoo.com', 'hotmail.com', 'outlook.com', 'icloud.com', 'proton.me'];\nconst domain = email.split('@')[1] || '';\nconst isBusinessEmail = domain !== '' && !freeMailDomains.includes(domain);\n\n// Simple lead score used by sales to prioritise follow-up.\nlet score = 0;\nif (isBusinessEmail) score += 40;\nif (company) score += 25;\nif (message.length > 80) score += 20;\nif (/budget|quote|pricing|urgent|asap/i.test(message)) score += 15;\n\nconst now = new Date();\n\nreturn {\n  json: {\n    cfg,\n    valid: errors.length === 0,\n    errors,\n    lead: {\n      name,\n      email,\n      company,\n      message,\n      source,\n      domain,\n      is_business_email: isBusinessEmail,\n      score: Math.min(score, 100),\n      created_at: now.toISOString(),\n      created_date: now.toISOString().slice(0, 10),\n      status: 'new',\n    },\n  },\n};\n"
      },
      "notes": "Trims, lower-cases email, title-cases name, scores the lead 0-100 and flags invalid input.",
      "notesInFlow": true
    },
