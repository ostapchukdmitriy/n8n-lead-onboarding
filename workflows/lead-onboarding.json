        "path": "lead-intake",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "notes": "POST JSON or form-encoded body: { name, email, company, message }.\nOptional: source, utm_campaign. Protect with a header-auth credential in production.",
      "notesInFlow": true
    },
    {
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Config",
