      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1680,
        400
      ],
      "parameters": {
        "fromEmail": "={{ $('Config').first().json.cfg.fromEmail }}",
        "toEmail": "={{ $('Validate & Normalise').first().json.lead.email }}",
        "subject": "=Thanks for reaching out, {{ $('Validate & Normalise').first().json.lead.name.split(' ')[0] }}!",
        "emailFormat": "html",
        "html": "=<!doctype html>\n<html>\n  <body style=\"font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; color:#1f2937; line-height:1.55; max-width:560px; margin:0 auto; padding:24px;\">\n    <h2 style=\"margin:0 0 12px;\">Hi {{ $('Validate & Normalise').first().json.lead.name.split(' ')[0] }},</h2>\n    <p>Thanks for contacting <strong>{{ $('Config').first().json.cfg.companyName }}</strong>. We received your message and a member of our team will get back to you within one business day.</p>\n    <p style=\"background:#f3f4f6; border-left:4px solid #6366f1; padding:12px 16px; border-radius:4px;\">\n      <em>“{{ $('Validate & Normalise').first().json.lead.message.slice(0, 400) }}”</em>\n    </p>\n    <p>If anything is urgent, just reply to this email.</p>\n    <p style=\"margin-top:28px;\">Best regards,<br/>The {{ $('Config').first().json.cfg.companyName }} team</p>\n    <hr style=\"border:none; border-top:1px solid #e5e7eb; margin:28px 0 12px;\"/>\n    <p style=\"font-size:12px; color:#6b7280;\">You are receiving this email because you submitted the contact form on our website.</p>\n  </body>\n</html>",
        "options": {
          "replyTo": "={{ $('Config').first().json.cfg.fromEmail }}",
          "appendAttribution": false
        }
