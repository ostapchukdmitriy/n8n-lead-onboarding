# Copy to .env and fill in. Never commit .env.

# ---- n8n instance --------------------------------------------------------
N8N_VERSION=latest
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
# Public base URL – used to build webhook URLs. Behind a reverse proxy set e.g. https://n8n.yourdomain.com/
WEBHOOK_URL=http://localhost:5678/
# Set to true when served over HTTPS
N8N_SECURE_COOKIE=false
# 32+ random chars. Encrypts stored credentials – losing it means re-entering every credential.
#   openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
GENERIC_TIMEZONE=Europe/Vilnius

# ---- Postgres ------------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# ---- Values you paste into the workflow "Config" nodes (not read by Docker) ----
# GOOGLE_SHEET_ID=1AbC...            (from the sheet URL)
# TELEGRAM_SALES_CHAT_ID=-100123...  (channel / group id, negative number)
# FROM_EMAIL="Sales Team <sales@yourdomain.com>"
